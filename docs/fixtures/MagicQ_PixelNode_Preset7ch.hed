// ChamSys MagicQ Head Definition File
// PixelNode - WS2811 Strip (Preset 7ch Pro)

NAME "PixelNode WS2811 Strip"
SHORTNAME "PxNode7"
MANUFACTURER "PixelNode"

CHANNELS 7
DIPSWITCH 0

// Channel 1: Dimmer / Strobe
CHAN 1
NAME "Dim/Strobe"
TYPE INTENSITY
RANGE 0 7 "Blackout"
RANGE 8 134 "Dimmer 0-100%"
RANGE 135 239 "Strobe Slow-Fast"
RANGE 240 255 "Full Open"
DEFAULT 0

// Channel 2: Red
CHAN 2
NAME "Red"
TYPE COLOUR
COLOUR RED
RANGE 0 255 "Red 0-100%"
DEFAULT 0

// Channel 3: Green
CHAN 3
NAME "Green"
TYPE COLOUR
COLOUR GREEN
RANGE 0 255 "Green 0-100%"
DEFAULT 0

// Channel 4: Blue
CHAN 4
NAME "Blue"
TYPE COLOUR
COLOUR BLUE
RANGE 0 255 "Blue 0-100%"
DEFAULT 0

// Channel 5: White
CHAN 5
NAME "White"
TYPE COLOUR
COLOUR WHITE
RANGE 0 255 "White 0-100%"
DEFAULT 0

// Channel 6: Pattern
CHAN 6
NAME "Pattern"
TYPE BEAM
RANGE 0 7 "Static"
RANGE 8 15 "Single Chase"
RANGE 16 23 "Dual Meteor"
RANGE 24 31 "Gravity Bounce"
RANGE 32 39 "Newton's Cradle"
RANGE 40 47 "Liquid Ripple"
RANGE 48 55 "Plasma Flow"
RANGE 56 63 "Sand Cascade"
RANGE 64 71 "Sine Breath"
RANGE 72 79 "Heartbeat Pulse"
RANGE 80 87 "Campfire Flicker"
RANGE 88 95 "Aurora Curtain"
RANGE 96 103 "Electric Arc"
RANGE 104 111 "Firefly Swarm"
RANGE 112 119 "Neural Synapse"
RANGE 120 127 "Jellyfish"
RANGE 128 135 "Rainbow Flow"
RANGE 136 143 "Knight Rider"
RANGE 144 151 "Center Wipe"
RANGE 152 159 "Strobe Matrix"
RANGE 160 167 "Diamond Sparkle"
RANGE 168 175 "Sawtooth Run"
RANGE 176 183 "Matrix Rain"
RANGE 184 191 "Moire Grid"
RANGE 192 255 "Reserved / Static"
DEFAULT 0

// Channel 7: Audio Sync
CHAN 7
NAME "Audio Sync"
TYPE BEAM
RANGE 0 7 "Off (Use Ch6 Pattern)"
RANGE 8 15 "Master Pulse"
RANGE 16 23 "Kick Pump Flash"
RANGE 24 31 "Snare Snap Flash"
RANGE 32 39 "Hi-Hat Glitter"
RANGE 40 47 "Drum Kit 3-Way"
RANGE 48 55 "Shockwave Blast"
RANGE 56 63 "Beat Step Walk"
RANGE 64 71 "Beat Invert Strobe"
RANGE 72 79 "Linear 7-Band VU"
RANGE 80 87 "Center-Out VU"
RANGE 88 95 "Pro Peak Hold VU"
RANGE 96 103 "Bass Wave Expand"
RANGE 104 111 "Sub-Bass Rumble"
RANGE 112 119 "Vocal Ribbon"
RANGE 120 127 "Spectral Centroid"
RANGE 128 135 "Multi-Band Fountain"
RANGE 136 143 "BPM Master Tempo"
RANGE 144 151 "Half/Double Tempo"
RANGE 152 159 "Drop Buildup & Blast"
RANGE 160 167 "Dynamic Ambient"
RANGE 168 175 "Audio Glitch"
RANGE 176 183 "Acoustic Resonance"
RANGE 184 191 "Bass Tunnel"
RANGE 192 199 "Silence Safe Fallback"
RANGE 200 255 "Reserved / Off"
DEFAULT 0
