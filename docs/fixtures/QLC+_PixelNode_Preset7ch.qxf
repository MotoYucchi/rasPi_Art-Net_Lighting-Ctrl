 <Model>WS2811 Strip Node</Model>
 <Type>Color Changer</Type>
 <Channel Name="Dimmer / Strobe" Preset="ShutterStrobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="7">Blackout (Off)</Capability>
  <Capability Min="8" Max="134">Master Dimmer (0% to 100%)</Capability>
  <Capability Min="135" Max="239">Strobe (Slow 1Hz to Fast 25Hz)</Capability>
  <Capability Min="240" Max="255">Full Open (100%)</Capability>
 </Channel>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Pattern">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="0">Static (Base Color)</Capability>
  <Capability Min="1" Max="63">Pattern Bank 1 (Chase)</Capability>
  <Capability Min="64" Max="127">Pattern Bank 2 (Sine Wave)</Capability>
  <Capability Min="128" Max="191">Pattern Bank 3 (Rainbow)</Capability>
  <Capability Min="192" Max="255">Pattern Bank 4 (Dynamic)</Capability>
 </Channel>
 <Channel Name="Audio Sync">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="0">Off (Use Pattern ch6)</Capability>
  <Capability Min="1" Max="31">Master Pulse (RMS Volume)</Capability>
  <Capability Min="32" Max="63">Kick Pump (Flash &amp; Bass)</Capability>
  <Capability Min="64" Max="95">Bass Wave</Capability>
  <Capability Min="96" Max="127">Beat Step (Chase step on beat)</Capability>
  <Capability Min="128" Max="159">Tempo Sync (Lock speed to BPM)</Capability>
  <Capability Min="160" Max="191">Snare Flash</Capability>
  <Capability Min="192" Max="255">7-Band Spectrum VU</Capability>
 </Channel>
 <Mode Name="Preset 7ch">
